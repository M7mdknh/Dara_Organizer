# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development

APP_URL=http://localhost:3000

# Generate a strong secret (>=32 chars) in production, e.g. `openssl rand -base64 32`.
SESSION_SECRET=replace_with_a_random_32plus_char_secret


# ============================================================
# DATABASE (PostgreSQL + pgvector)
# ============================================================

DATABASE_URL=postgresql://dialect:dialect_dev_password@localhost:5433/dialect_platform

# Optional. Used only when running `prisma migrate deploy` / `npm run admin:create`
# against a connection pooler (e.g. Supabase's pgbouncer transaction-mode pooler
# on port 6543) that doesn't support the session-level features migrations need.
# Point it at a session-mode/direct connection (e.g. the same host on port 5432).
# If your DATABASE_URL is already a direct connection, leave this unset.
# Any password containing special characters (@, :, /, [, ], etc.) MUST be
# percent-encoded in both URLs — an unescaped "@" is a common cause of
# confusing "password authentication failed" errors.
DIRECT_DATABASE_URL=


# ============================================================
# AI PROVIDER
# ============================================================
# none      -> AI features disabled; all core workflows still work
# mock      -> clearly-labeled dev placeholder output, no network calls
# anthropic -> requires ANTHROPIC_API_KEY
# openai    -> requires OPENAI_API_KEY, enables embeddings + pgvector matching

AI_PROVIDER=none

ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

OPENAI_API_KEY=

# Primary linguistic reasoning/enrichment model.
OPENAI_MODEL=gpt-5.6-terra

# Difficult semantic adjudication only — not called for every item.
OPENAI_ADJUDICATION_MODEL=gpt-5.6-sol

# Semantic retrieval.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Must match the pgvector column dimension (see prisma/schema.prisma Embedding model).
OPENAI_EMBEDDING_DIMENSIONS=3072

OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=3


# ============================================================
# SEMANTIC MATCHING
# ============================================================

SEMANTIC_MATCHING_ENABLED=false

# Number of vector candidates supplied to semantic adjudication.
SEMANTIC_TOP_K=10

# Candidate retrieval threshold. This is a RETRIEVAL threshold, not proof
# of semantic equivalence — the LLM judgment stage makes the actual call.
SEMANTIC_VECTOR_MIN_SIMILARITY=0.55

# Never automatically promote semantic similarity alone to Gold/verified.
SEMANTIC_AUTO_APPROVE=false

# Allow escalating uncertain cases to OPENAI_ADJUDICATION_MODEL.
SEMANTIC_ADJUDICATION_ENABLED=true


# ============================================================
# REDIS / BACKGROUND JOBS
# ============================================================

REDIS_URL=redis://localhost:6379
# Use rediss:// (TLS) for managed providers such as Upstash.

# When false, imports/enrichment run synchronously in the request handler
# (fine for small local imports and for running without Redis).
BACKGROUND_JOBS_ENABLED=false

WORKER_CONCURRENCY=4
IMPORT_CHUNK_SIZE=500
AI_JOB_CONCURRENCY=2
EMBEDDING_BATCH_SIZE=100


# ============================================================
# OBJECT STORAGE
# ============================================================
# local -> files are not persisted to durable storage (dev-only fallback)
# s3    -> any S3-compatible provider (AWS S3, Cloudflare R2, DO Spaces, MinIO)

STORAGE_PROVIDER=local

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set true for providers requiring path-style addressing (e.g. MinIO, Supabase Storage).
S3_FORCE_PATH_STYLE=false

# Optional public/base URL for constructing shareable links.
S3_PUBLIC_URL=


# ============================================================
# UPLOADS
# ============================================================

MAX_UPLOAD_SIZE_MB=250
ALLOWED_IMPORT_TYPES=xlsx,csv,txt

# Future audio/video ingestion — schema exists, pipeline is not built.
MEDIA_UPLOADS_ENABLED=false


# ============================================================
# DATASET EXPORT / IMPORT STORAGE PREFIXES
# ============================================================

EXPORT_STORAGE_PREFIX=exports/
IMPORT_STORAGE_PREFIX=imports/


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info
